# B1 reuses the tested B0 security/transport, in its own generated profile.
CONFIG_LUNA_BLE_B1_MUSIC=y
CONFIG_LUNA_BLE_B0_WIFI_TEST=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ble_b1.csv"
CONFIG_PM_ENABLE=y
# CONFIG_PM_DFS_INIT_AUTO is not set
