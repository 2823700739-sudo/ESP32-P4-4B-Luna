# Separate diagnostic profile; no rewrite of the daily sdkconfig or C6 flash.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# IDF 6.0.2 NVS sorting triggers GCC array-bounds errors for a one-entry array.
# Three storage slots; one live connection, each new bond needs on-screen approval.
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Avoid the P4 TinyCrypt ECC path implicated by DHKey check failure (0x40b).
# Use IDF's supported crypto backend; retain SC/MITM and 128-bit bonded GATT.
CONFIG_BT_SMP_CRYPTO_STACK_TINYCRYPT=n
CONFIG_BT_SMP_CRYPTO_STACK_MBEDTLS=y
CONFIG_BT_NIMBLE_CRYPTO_STACK_MBEDTLS=y
CONFIG_LUNA_BLE_B0=y
CONFIG_LUNA_BLE_B0_LEGACY_HCI_PROBE=y
