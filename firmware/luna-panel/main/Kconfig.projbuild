menu "Luna Current Product"

    config LUNA_BLE_B0
        bool "Build the isolated Luna BLE B0 diagnostic application"
        default n
        depends on BT_NIMBLE_ENABLED && ESP_HOSTED_ENABLE_BT_NIMBLE
        help
            Minimal paired GATT hello/ping/time diagnostic only. Does not start
            USB CDC, the old HTTP Agent client, music, or cover tasks.
            Use the separate build-firmware.ps1 -BleB0 profile.

    config LUNA_BLE_B0_LEGACY_HCI_PROBE
        bool "Allow diagnostic HCI probe for old pre-2.5.2 C6 firmware"
        default n
        depends on LUNA_BLE_B0
        help
            Old Hosted firmware enables its Bluetooth controller at boot and
            lacks the newer controller-init RPC. If both version and init RPCs
            fail, try NimBLE HCI synchronization, without changing C6 flash.
            Diagnostic only; failure is not evidence of a working controller.

    config LUNA_BLE_B0_WIFI_TEST
        bool "Run device weather Wi-Fi alongside the B0 BLE diagnostic"
        default n
        depends on LUNA_BLE_B0
        help
            Optional coexistence gate using current C6 firmware, local Wi-Fi
            credentials and the weather location/cache already saved in NVS.
            Does not start the PC HTTP channel, NTP or USB CDC. BLE supplies
            valid time before HTTPS. No restore of a saved timestamp as a clock.

    config LUNA_BLE_B1_MUSIC
        bool "Run the current five-card Luna product"
        default n
        depends on LUNA_BLE_B0
        help
            Reuse the secured BLE transport with bounded music snapshots and
            a non-replaying action FIFO. Fixed player, no covers/USB/PC HTTP.
            Five approved cards, interactive pet and independent weather.

    config LUNA_WIFI_SSID
        string "2.4 GHz Wi-Fi SSID"
        default ""
        help
            Network name used by the Luna firmware. Stored only in the generated sdkconfig.

    config LUNA_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Network password used by the Luna firmware. Stored only in the generated sdkconfig.

endmenu
