 cities.forEach((city,i)=>$('choices').add(new Option([city.name,city.admin1,city.country].filter(Boolean).join(' Â· '),String(i))));$('choicesLabel').hidden=false;if(!cities.length)notice('æ²¡æœ‰æ‰¾åˆ°åœ°ç‚¹ï¼Œè¯•è¯•æ‹¼éŸ³ï¼Œæˆ–æ‰‹åŠ¨å¡«å†™ç»çº¬åº¦ã€‚');}
 catch(error){notice(error.message+' å¯æ”¹ç”¨æ‹¼éŸ³æˆ–æ‰‹åŠ¨å¡«å†™ç»çº¬åº¦ã€‚');}
 finally{await poll();}
});
$('choices').addEventListener('change',()=>{const city=cities[Number($('choices').value)];if($('choices').value!==''&&city){$('location').value=city.name;$('latitude').value=city.latitude;$('longitude').value=city.longitude;}});
$('save').addEventListener('click',async()=>{
 if(pending||saved||uncertain||scanning)return;
 try{
 const fields=networkFields(),location=$('location').value.trim();
 if(!location||byteLength(location)>47||!$('latitude').value.trim()||!$('longitude').value.trim())throw Error('è¯·å…ˆé€‰æ‹©åœ°ç‚¹ï¼Œæˆ–å®Œæ•´å¡«å†™åœ°ç‚¹ä¸ç»çº¬åº¦ã€‚');
 const latitude=Number($('latitude').value),longitude=Number($('longitude').value);
 if(!Number.isFinite(latitude)||Math.abs(latitude)>90||!Number.isFinite(longitude)||Math.abs(longitude)>180)throw Error('ç»çº¬åº¦èŒƒå›´ä¸æ­£ç¡®ã€‚');
 if(!fields.password&&!confirm('å°†ä¿å­˜å¼€æ”¾ Wi-Fiã€‚ç¡®è®¤ç»§ç»­ï¼Ÿ'))return;
 requestId=newId();pending=true;uncertain=true;$('save').disabled=true;notice('');
 await api('/api/save',{setup_id:requestId,...fields,location,latitude,longitude});
 }catch(error){if(error.status===400||error.status===503){requestId='';pending=false;uncertain=false;}notice('ä¿å­˜æœªç¡®è®¤ï¼š'+error.message+' è‹¥å·²å‘é€ï¼Œå…ˆç­‰å¾…è¯»å–è®¾å¤‡çŠ¶æ€ï¼Œä¸è¦é‡å¤æäº¤ã€‚');}
 finally{if(!requestId){pending=false;uncertain=false;}await poll();}
});
$('close').addEventListener('click',async()=>{try{await api('/api/close',{});notice('æ­£åœ¨å…³é—­çƒ­ç‚¹ã€‚æœªä¿å­˜çš„è¯•è¿è®¾ç½®å°†æ¢å¤ä¸ºåŸé…ç½®ã€‚');}catch(error){notice('çƒ­ç‚¹å¯èƒ½å·²å…³é—­ï¼Œè¯·è§‚å¯Ÿ Lunaã€‚');}});
(async()=>{try{const session=await api('/api/session');token=session.token;$('connect').disabled=false;$('save').disabled=false;$('close').disabled=false;await poll();setInterval(poll,2000);}catch(error){notice('è¯·è¿æ¥ Luna çƒ­ç‚¹ï¼Œåœ¨æµè§ˆå™¨æ‰“å¼€ http://192.168.4.1ã€‚');}})();
</script></html>
