 const index=$('networks').value,wifi=networks[Number(index)];
 if(index!==''&&wifi){$('ssid').value=wifi.ssid;$('password').value='';$('password').placeholder=wifi.secured?'è¯·è¾“å…¥è¿™ä¸ª Wi-Fi çš„å¯†ç ':'æ­¤ç½‘ç»œæ— éœ€å¯†ç ';$('password').focus();}
});
$('network').addEventListener('submit',async event=>{
 event.preventDefault();if(pending||saved||uncertain||scanning)return;
 try{const fields=networkFields();if(!fields.password&&!confirm('ç¡®è®¤è¿æ¥æ— å¯†ç çš„å¼€æ”¾ç½‘ç»œï¼Ÿ'))return;pending=true;$('connect').disabled=true;notice('');await api('/api/network',fields);notice('æ­£åœ¨è¯•è¿ã€‚è¯·ä¿æŒæ‰‹æœºè¿æ¥ Lunaï¼Œç„¶åé€‰æ‹©å¤©æ°”åœ°ç‚¹ã€‚');}
