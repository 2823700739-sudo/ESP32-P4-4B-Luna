<button id="save" disabled>ä¿å­˜åˆ° Luna</button><small>åŸå¸‚æœç´¢ç”± Luna è”ç½‘æŸ¥è¯¢ Open-Meteo / GeoNamesï¼ŒWi-Fi å¯†ç ä¸ä¼šå‘é€ç»™åŸå¸‚æœåŠ¡ã€‚åŒååœ°ç‚¹è¯·æŒ‰çœä»½ä¸å›½å®¶é€‰æ‹©ï¼›ä¹Ÿå¯ç›´æ¥å¡«å†™æ˜ç¡®ç»çº¬åº¦ã€‚</small></section>
<button id="close" class="secondary" disabled>å…³é—­é…ç½®çƒ­ç‚¹</button><small>çƒ­ç‚¹æœ€å¤šå¼€æ”¾ 10 åˆ†é’Ÿï¼ŒæˆåŠŸä¿å­˜å¹¶è”ç½‘åçº¦ 20 ç§’å…³é—­ã€‚è®¾ç½®ä¿å­˜åœ¨è®¾å¤‡ä¸Šï¼›å¤©æ°”ä¸ NTP æ ¡æ—¶ç”± Luna ç‹¬ç«‹è”ç½‘ã€‚Windows è„šæœ¬ä»…ç”¨äºç”µè„‘ç›¸å…³æ•°æ®å’Œæ§åˆ¶ã€‚</small>
<script>
'use strict';
const $=id=>document.getElementById(id);
let token='',requestId='',cities=[],pending=false,saved=false,polling=false,uncertain=false;
let networks=[],scanning=false,scanUntil=0;
const byteLength=s=>new TextEncoder().encode(s).length;
function notice(text){$('notice').textContent=text;}
function networkFields(){
 const ssid=$('ssid').value,password=$('password').value;
 if(!ssid||byteLength(ssid)>32)throw Error('Wi-Fi åç§°éœ€è¦ 1ï½32 ä¸ª UTF-8 å­—èŠ‚ã€‚');
 if(password && (!/^[\x20-\x7e]{8,63}$/.test(password)&&!/^[0-9a-fA-F]{64}$/.test(password)))throw Error('å¯†ç åº”ä¸º 8ï½63 ä¸ª ASCII å­—ç¬¦ï¼Œæˆ– 64 ä½åå…­è¿›åˆ¶å¯†é’¥ã€‚');
 return {ssid,password};
}
async function api(path,data){
 const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),15000);let response;
 try{response=await fetch(path,{method:data===undefined?'GET':'POST',headers:{'X-Luna-Token':token,...(data===undefined?{}:{'Content-Type':'application/json'})},body:data===undefined?undefined:JSON.stringify(data),cache:'no-store',signal:controller.signal});}
 catch(error){throw Error('ä¸ Luna çš„è¿æ¥ä¸­æ–­æˆ–è¶…æ—¶ï¼Œè¯·ä¿æŒçƒ­ç‚¹è¿æ¥å¹¶ç­‰å¾…çŠ¶æ€æŸ¥è¯¢ã€‚');}
 finally{clearTimeout(timer);}
 if(!response.ok){const messages={400:'è¾“å…¥æ ¼å¼ä¸æ­£ç¡®ï¼Œè¯·æ£€æŸ¥ç½‘ç»œæˆ–åœ°ç‚¹ä¿¡æ¯ã€‚',403:'é…ç½®é¡µé¢å·²è¿‡æœŸï¼Œè¯·é‡æ–°è¿æ¥ Luna çƒ­ç‚¹å¹¶åˆ·æ–°ã€‚',503:'è®¾å¤‡å¿™æˆ–ç½‘ç»œæœåŠ¡æš‚ä¸å¯ç”¨ï¼Œè¯·å…ˆè§‚å¯ŸçŠ¶æ€åé‡è¯•ã€‚'};const error=Error(messages[response.status]||'è®¾å¤‡æš‚æ—¶æ— æ³•å¤„ç†è¯·æ±‚ï¼Œè¯·ç¨åé‡è¯•ã€‚');error.status=response.status;throw error;}return response.json();
}
function newId(){const bytes=new Uint8Array(16);crypto.getRandomValues(bytes);return Array.from(bytes,v=>v.toString(16).padStart(2,'0')).join('');}
async function pollScan(){
 if(!scanning)return;
 try{
 const result=await api('/api/scan');
 if(result.state===1 && Date.now()<scanUntil)return;
 scanning=false;$('scan').textContent='é‡æ–°æ‰«æ Wi-Fi';
 if(result.state!==2){$('scanStatus').textContent='æ‰«ææœªå®Œæˆï¼Œè®¾å¤‡å¯èƒ½æ­£åœ¨è¿æ¥ç½‘ç»œã€‚ç¨ç­‰å‡ ç§’é‡è¯•ï¼Œæˆ–æ‰‹åŠ¨è¾“å…¥ Wi-Fi åç§°ã€‚';return;}
 networks=result.networks||[];$('networks').replaceChildren(new Option('è¯·é€‰æ‹©ç½‘ç»œ',''));
 networks.forEach((wifi,i)=>$('networks').add(new Option(`${wifi.ssid} Â· ${wifi.secured?'éœ€å¯†ç ':'æ— å¯†ç '} Â· ${wifi.rssi>=-60?'ä¿¡å·å¼º':wifi.rssi>=-75?'ä¿¡å·ä¸­ç­‰':'ä¿¡å·å¼±'}`,String(i))));
 $('networksLabel').hidden=!networks.length;
 $('scanStatus').textContent=networks.length?'è¯·é€‰æ‹©ç½‘ç»œï¼Œå†è¾“å…¥å¯†ç ã€‚é€‰ä¸­ä¸ä¼šè‡ªåŠ¨è¿æ¥ã€‚':'æ²¡æœ‰æ‰¾åˆ°å¯ç”¨ç½‘ç»œï¼Œè¯·é è¿‘è·¯ç”±å™¨åé‡è¯•ï¼Œæˆ–æ‰‹åŠ¨è¾“å…¥åç§°ã€‚';
 }catch(error){if(Date.now()>=scanUntil){scanning=false;$('scan').textContent='é‡æ–°æ‰«æ Wi-Fi';$('scanStatus').textContent='æ‰«æçŠ¶æ€è¯»å–å¤±è´¥ï¼Œè¯·ä¿æŒè¿æ¥ Luna çƒ­ç‚¹åé‡è¯•ï¼Œæˆ–æ‰‹åŠ¨è¾“å…¥åç§°ã€‚';}}
}
async function poll(){
 if(polling)return;polling=true;
 try{
 const state=await api('/api/status'),ours=!!requestId&&state.setup_id===requestId;
 saved=ours&&state.saved;
 let lines=[`çƒ­ç‚¹å‰©ä½™ ${Math.ceil(state.remaining_seconds/60)} åˆ†é’Ÿ`,state.online?'Wi-Fi å·²è¿æ¥':state.wifi_error?'Wi-Fi åˆå§‹åŒ–å¤±è´¥ï¼Œè¯·æŸ¥çœ‹ Luna å±å¹•å¹¶å‘ç»´æŠ¤è€…æä¾›çŠ¶æ€ç ':'ç­‰å¾… Wi-Fi è¿æ¥ï¼Œè¯·æ£€æŸ¥åç§°ã€å¯†ç åŠ 2.4 GHz ç½‘ç»œ'];
 if(ours&&state.state===1)lines.push('æ­£åœ¨ä¿å­˜ï¼Œè¯·å‹¿æ–­ç”µâ€¦');
 if(ours&&state.state===4){lines.push('ä¿å­˜å¤±è´¥ï¼ŒåŸæœ‰è®¾ç½®ä»ä¿ç•™ã€‚');pending=false;uncertain=false;}
 if(saved){lines.push('è®¾ç½®å·²ä¿å­˜åˆ°è®¾å¤‡ã€‚');lines.push(state.weather_fresh?'æœ€æ–°å¤©æ°”å·²å°±ç»ªã€‚':'ç­‰å¾…è®¾å¤‡æ ¡æ—¶å’Œæœ€æ–°å¤©æ°”ã€‚');$('password').value='';}
 else if(state.online&&!state.clock_ready)lines.push('æ­£åœ¨è”ç½‘æ ¡æ—¶ï¼Œè¯·ç¨å€™å†æœç´¢åŸå¸‚ï¼›ä¹Ÿå¯æ‰‹å¡«ç»çº¬åº¦ã€‚');
 if(ours&&state.state===3)lines.push('è®¾ç½®å·²ä¿å­˜ï¼Œä½†æ— çº¿åˆå§‹åŒ–å¤±è´¥ï¼Œå°šæœªè”ç½‘ã€‚');
 $('status').textContent=lines.join('\n');
 if(ours&&state.state!==1){pending=false;uncertain=false;}
 await pollScan();
 $('find').disabled=!state.online||!state.clock_ready||pending||scanning;
 $('connect').disabled=pending||saved||uncertain||scanning;
 $('save').disabled=pending||saved||uncertain||scanning;
 $('scan').disabled=pending||saved||uncertain||scanning;
 $('networks').disabled=pending||saved||uncertain||scanning;
 }catch(error){$('status').textContent=saved?'é…ç½®å·²ä¿å­˜ï¼›çƒ­ç‚¹å¯èƒ½å·²è‡ªåŠ¨å…³é—­ã€‚è¯·è®©æ‰‹æœºé‡æ–°è¿æ¥åŸ Wi-Fiï¼Œè§‚å¯Ÿ Luna å¤©æ°”ã€‚':'æš‚æ—¶æ— æ³•è¯»å–çŠ¶æ€ï¼Œè¯·ä¿æŒè¿æ¥ Luna çƒ­ç‚¹ã€‚è‹¥åˆšå‘é€ä¿å­˜ï¼Œè¯·å‹¿é‡å¤æäº¤ï¼›æ¢å¤è¿æ¥åå…ˆç­‰å¾…è¯»å–çŠ¶æ€ã€‚';}
 finally{polling=false;}
}
$('scan').addEventListener('click',async()=>{
 if(pending||saved||uncertain||scanning)return;
 scanning=true;scanUntil=Date.now()+30000;$('scan').disabled=true;$('connect').disabled=true;$('save').disabled=true;
 $('networks').disabled=true;$('scan').textContent='æ­£åœ¨æ‰«æâ€¦';$('scanStatus').textContent='Luna æ­£åœ¨æ‰«æé™„è¿‘ç½‘ç»œï¼Œè¯·ä¿æŒçƒ­ç‚¹è¿æ¥â€¦';
 networks=[];$('networks').replaceChildren(new Option('è¯·é€‰æ‹©ç½‘ç»œ',''));$('networksLabel').hidden=true;
 try{await api('/api/scan',{});await poll();}
 catch(error){if(error.status){scanning=false;$('scan').textContent='é‡æ–°æ‰«æ Wi-Fi';$('scanStatus').textContent='è®¾å¤‡å¿™ï¼Œè¯·ç¨ç­‰å‡ ç§’é‡æ–°æ‰«æï¼›ä¹Ÿå¯æ‰‹åŠ¨è¾“å…¥åç§°ã€‚';}else{$('scanStatus').textContent='è¯·æ±‚ç»“æœæœªç¡®è®¤ï¼Œæ­£åœ¨æŸ¥è¯¢æ‰«æçŠ¶æ€ï¼Œè¯·ä¿æŒçƒ­ç‚¹è¿æ¥â€¦';}await poll();}
});
$('networks').addEventListener('change',()=>{
